# Copia este archivo como ".env" y completa los valores reales.
# Solo se usa como plantilla segura (contenido genérico).

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.onrender.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/?retryWrites=true
MONGODB_NAME=hotel

# Emails (opcional: sin estos valores, los correos no se envian y solo se registran en el log)
# Ejemplo con Gmail (requiere clave de aplicacion: cuenta Google -> Seguridad -> Verificacion en 2 pasos -> Claves de contrasena):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Hotel H.H. <tucorreo@gmail.com>
#
# Ejemplo con Resend (https://resend.com, gratis por API key):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_tu_api_key
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Hotel H.H. <onboarding@resend.dev>
